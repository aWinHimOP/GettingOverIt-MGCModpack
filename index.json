    {
      "id": "mod:MGCModpack",
      "kind": "mod",
      "name": "MGCModpack",
      "versions": [
        {
          "version": "1.0.0",
          "file": "mod/MGCModpack.modpack",
          "url": "https://raw.githubusercontent.com/aWinHimOP/GettingOverIt-MGCModpack/main/mod/MGCModpack.modpack",
          "sha256": "da8c73651938c345720ff265ab905257407384b4cb5d8f73a35a7d349e6a7162",
          "size": 131080,
          "publishedAt": "2026-10-09T12:57:26Z",
          "notes": "AIGOI v8.1 \u4FEE\u300C\u91CD\u7F6E\u573A\u666F\u7528\u4E0D\u4E86\u300D\uFF1A\u5C40\u672B\u7ED9 PC \u4E0A\u62A5\u9002\u5E94\u5EA6\u65F6 pfit[i] = _fit[i] \u8D8A\u754C\uFF08_fit \u53EA\u6709\u5B50\u4EE3\u7406\u90A3 8 \u4E2A\uFF0Ci \u5374\u8D70\u5230 12 \u4E2A\uFF09\uFF0C\u5F02\u5E38\u629B\u5728 LoadScene \u4E4B\u524D \u2192 \u91CD\u7F6E\u6C38\u8FDC\u6267\u884C\u4E0D\u5230\u3001\u6BCF\u5E27\u91CD\u629B 30 \u6B21\u8FD8\u628A\u8BAD\u7EC3\u505C\u4E86\u3002\u5DF2\u6309\u5B50\u4EE3\u7406/\u6574\u5408\u8005\u5206\u6BB5\u53D6\u503C\uFF0C\u5E76\u5728\u9996\u6B21\u51FA\u9519\u65F6\u6253\u5B8C\u6574\u5806\u6808\u3002\u53E6\u628A UIControls.CreateToggle \u7684 hideValueText \u9ED8\u8BA4\u503C\u6539\u56DE false\uFF08\u53F3\u4FA7 \u5F00/\u5173 \u4E4B\u524D\u88AB SetActive(false) \u5E72\u6389\uFF09\uFF0CAIGOI \u516B\u4E2A\u5F00\u5173\u4E5F\u663E\u5F0F\u4F20 false\u3002\n\nAIGOI v8.0 \u4FEE\u4E09\u4E2A\u771F bug\uFF1A(1) \u9B3C\u5F71\u7684 PlayerSounds \u7EC4\u4EF6\u6CA1\u5220\u800C AudioSource \u88AB\u5220 \u2192 \u6BCF\u5E27\u7A7A\u5F15\u7528\uFF0C\u4E00\u4F1A\u8BDD 13841 \u884C\u5F02\u5E38\u3001\u6E38\u620F\u8FDE\u7EED\u5D29\u6E83 8 \u6B21\u3001UI \u5E03\u5C40\u8DD1\u4E0D\u5B8C\uFF08toggle \u574F\u6389/\u6309\u952E\u6D88\u5931\u5C31\u662F\u8FD9\u4E2A\uFF09\uFF1B\u73B0\u5728\u6309\u7C7B\u578B\u5220 PlayerSounds/PotSounds\u3001AudioSource \u6539\u9759\u97F3\uFF08HammerCollisions \u81EA\u5DF1\u8981\u7528\u5B83\uFF09\u3002(2) \u91CD\u8F7D\u573A\u666F\u6CA1\u6E05\u5B58\u6863 \u2192 \u6BCF\u5C40\u4ECE\u4E3B\u73A9\u5BB6\u4E0A\u6B21\u4FDD\u5B58\u7684\u4F4D\u7F6E\u91CD\u5F00\u3001\u8D77\u70B9\u88AB\u9489\u6B7B\uFF1B\u73B0\u5728\u6309\u6846\u67B6 UIInitializer \u7684\u952E\u540D\u6E05 NumSaves/SaveGame0/SaveGame1\uFF0C\u4E0B\u4E00\u5C40\u4ECE\u5C71\u811A\u5F00\u59CB\u3002(3) loader alpha.48 \u6539\u56DE\u5DE5\u5177\u7EA6\u5B9A\u7684 versions/\u003C\u7248\u672C\u003E/MGCModpack.dll\u3002\n\nAIGOI v7.0 \u7075\u654F\u5EA6\u7531\u811A\u672C\u63A5\u7BA1 \u002B \u63A8\u7406\u4F4D\u7F6E\u53EF\u9009\u3002\u68C0\u67E5\u53D1\u73B0 PlayerControl.Start() \u4ECE PlayerPrefs/\u5E8F\u5217\u5316\u5B57\u6BB5\u53D6\u7075\u654F\u5EA6\uFF0C\u9B3C\u5F71\u4F1A\u7EE7\u627F\u300C\u514B\u9686\u90A3\u4E00\u523B\u73A9\u5BB6\u7684\u8BBE\u7F6E\u300D\u2192 \u4E2D\u9014\u8C03\u7075\u654F\u5EA6\u8BAD\u7EC3\u5C31\u4E0D\u53EF\u590D\u73B0\u3002\u73B0\u5728\u628A\u6D41\u6C34\u7EBF\u91CC\u4EC5\u6709\u7684\u56DB\u4E2A\u53EF\u8C03\u9879\uFF08mouseSensitivity / rawInputScaling / cursorVelocityToWorldUnits / deadzone\uFF09\u5FEB\u7167\u4E00\u6B21\u5E76\u5F3A\u5236\u5199\u5165\u6BCF\u4E2A\u9B3C\u5F71\uFF0C\u5E76\u6BCF\u4EE3\u6253\u4E00\u6761\u4E0E\u539F\u7248\u7684\u4E00\u81F4\u6027\u81EA\u68C0\u3002\u53E6\u63D0\u4F9B\u72EC\u7ACB PC \u63A8\u7406\u670D\u52A1 exe\uFF08Tools/pc_inference/dist/AIGOI.PCServer.exe\uFF0C\u4E0D\u9700\u8981 Python\uFF09\u3002\n\nAIGOI v6.0 \u76F8\u673A\u8DDF\u968F \u002B \u6574\u5408\u8005 AI\u3002\u76F8\u673A\uFF1A\u628A CameraControl.player \u6307\u5411\u6700\u4F18\u5B50\u4EE3\u7406\uFF08\u6362\u5F15\u7528\uFF0C\u4E0D\u52A8\u4EFB\u4F55 transform\uFF0C\u4E0D\u662F\u4F20\u9001\uFF09\uFF0C\u6E38\u620F\u81EA\u5DF1\u7684\u524D\u77BB/\u5E73\u6ED1/\u6C34\u4F4D\u903B\u8F91\u7167\u5E38\u3002\u6574\u5408\u8005\uFF1A\u4E00\u4E2A\u72EC\u7ACB\u7684\u53EF\u8FDB\u5316\u300C\u8BE5\u4FE1\u8C01\u300D\u6743\u91CD \u03B8\uFF0CG_master = \u03A3 softmax(\u03B8)_i\u00B7G_i\uFF0C\u5019\u9009\u7B56\u7565\u4F5C\u4E3A\u989D\u5916\u9B3C\u5F71\u5B9E\u6D4B\uFF1B\u5E76\u4FEE\u590D\u300C\u5408\u5E76\u65B0\u79CD\u7FA4\u5374\u7528\u4E0A\u4E00\u4EE3\u9002\u5E94\u5EA6\u300D\u7684\u4E0B\u6807\u9519\u4F4D\u3002\n\nAIGOI v5.0 \u91CD\u7F6E\u6539\u4E3A**\u91CD\u8F7D\u573A\u666F**\uFF08\u4E0D\u4F20\u9001\uFF09\uFF1A\u4EFB\u4F55\u4E00\u4E2A\u5B50\u4EE3\u7406\u843D\u6C34\u7ACB\u523B\u7ED3\u675F\u5168\u5C40\u8FD9\u4E00\u5C40\uFF0C\u6240\u6709\u9B3C\u5F71\u548C\u4E3B\u73A9\u5BB6\u4E00\u8D77\u91CD\u8F7D\u3001\u540C\u4E00\u6761\u65F6\u95F4\u7EBF\uFF1B\u76F8\u673A\u8DDF\u968F\uFF08\u9760\u642C\u4E3B\u73A9\u5BB6\u5B9E\u73B0=\u4F20\u9001\uFF09\u4E00\u6B21\u6027\u8FC1\u79FB\u5173\u95ED\u3002\u65B0\u589E **PC \u63A8\u7406**\uFF1A\u89C2\u6D4B\u7ECF UDP \u53D1\u5230\u7535\u8111\u3001\u52A8\u4F5C\u6536\u56DE\u6765\uFF0CPC \u6389\u7EBF\u81EA\u52A8\u9000\u56DE\u672C\u673A\u63A8\u7406\uFF0C\u9644 Tools/pc_inference/server.py\u3002\n\nAIGOI v4.1 \u9B3C\u5F71\u53EF\u89C1\u5316\uFF1A\u4E0D\u518D\u9690\u85CF\u6E32\u67D3\uFF08\u67D3\u8272 \u002B \u5934\u9876 #\u7F16\u53F7\uFF09\uFF0C\u65B0\u589E\u5DE6\u4FA7\u300C\u5B50\u4EE3\u7406\u72B6\u6001\u9762\u677F\u300D\uFF08\u6BCF\u4E2A\u9B3C\u5F71\u4E00\u884C\uFF1A\u91CC\u7A0B/TF/Y/\u5269\u4F59\u65F6\u95F4\uFF09\uFF0C\u65B0\u589E\u300C\u76F8\u673A\u8DDF\u968F\u9886\u5148\u7684\u5B50\u4EE3\u7406\u300D\uFF08\u771F\u5B9E\u73A9\u5BB6\u505C\u4E3A\u7EAF\u76F8\u673A\u951A\u70B9\uFF0C\u78B0\u649E\u4E0E\u6E32\u67D3\u5173\u95ED\uFF09\u3002\n\nAIGOI v4.0 \u73A9\u5BB6\u9884\u5236\u4F53\u7ADE\u6280\u573A\uFF1A\u514B\u9686\u771F\u5B9E\u73A9\u5BB6 N \u4EFD\u5F53\u300C\u5B50\u4EE3\u7406\u300D\u5E76\u884C\u91C7\u96C6\u7ECF\u9A8C\u3002\u7269\u7406\u5B8C\u5168\u7531\u6E38\u620F\u81EA\u5DF1\u7684 PlayerControl \u8DD1\uFF08\u4E0D\u662F\u590D\u523B\u516C\u5F0F\uFF09\uFF0C\u52A8\u4F5C\u6309 player.touch \u7684 c.Target \u5206\u53D1\uFF1B\u6BCF\u4E2A\u9B3C\u5F71\u914D\u72EC\u7ACB\u5149\u6807\u3001\u653E 31 \u5C42\u907F\u5F00\u6E38\u620F\u7684\u843D\u6C34\u68C0\u6D4B\u3002\u4E00\u4EE3 = \u4E00\u5C40\uFF08\u539F\u6765 \u03BB=24 \u21D2 \u4E00\u4EE3 25 \u5206\u949F\uFF0C\u8FD9\u5C31\u662F\u300C\u4EE3\u6B21\u6C38\u8FDC\u505C\u5728 0\u300D\u7684\u6839\u56E0\uFF09\u3002\n\nAIGOI v3.1 \u4FEE\u590D\u300CAI \u5B8C\u5168\u65E0\u6CD5\u79FB\u52A8\u300D\u7684\u6839\u56E0\uFF1Aplayer.cursor \u4E3A\u4E86\u7981\u6B62\u73A9\u5BB6\u64CD\u63A7\u800C\u65E0\u6761\u4EF6\u6E05\u96F6\uFF0C\u628A AI \u81EA\u5DF1\u521A\u5728 player.touch \u5199\u8FDB\u53BB\u7684\u52A8\u4F5C\u4E5F\u4E00\u8D77\u62B9\u6389\u4E86 \u2014\u2014 \u73B0\u5728\u6309\u5E27\u53F7\u533A\u5206\uFF0C\u53EA\u6390\u771F\u624B\u6307\u3002\n\nAIGOI v3.0 \u6539\u7528\u5408\u6210\u89E6\u6478\uFF08\u63D2\u6869\uFF09\n\n\u2605 \u8FD9\u662F\u7528\u6237\u4ECE\u7B2C\u4E00\u8F6E\u5C31\u8981\u6C42\u3001\u6211\u7ED5\u4E86\u5341\u51E0\u8F6E\u624D\u505A\u5BF9\u7684\u4E8B\u3002\n\n\u6539\u52A8\uFF1A\n1. \u7ED9 PlayerControl.Update \u63D2\u6869\uFF08\u4F4D\u7F6E\uFF1AInput.touchCount==0 \u7684\u63D0\u524D return \u5904\uFF09\n   \u6CA1\u6709\u771F\u5B9E\u624B\u6307\u65F6\uFF0Cmod \u53EF\u63D0\u4F9B\u5408\u6210\u8F93\u5165\uFF1A\n     MGCBridge.HookValue(\u0022player.touch\u0022, this, ref mgcDx, ref mgcDy, ref mgcDt);\n     mgcDt \u003E 0 \u8868\u793A\u63A5\u7BA1 \u2192 vector=(mgcDx,mgcDy), d=mgcDt, touchPhase=Moved\n2. \u65B0\u589E\u901A\u7528\u7AD9\u70B9 HookSites.PlayerTouch = \u0022player.touch\u0022 \u2014\u2014 **\u5176\u4ED6 mod \u4E5F\u80FD\u7528**\n   \uFF08\u5F55\u5C4F\u56DE\u653E\u3001\u811A\u672C\u6F14\u793A\u3001\u8F85\u52A9\u64CD\u4F5C\u2026\u2026\u4EFB\u4F55\u9700\u8981\u5408\u6210\u89E6\u6478\u7684 mod\uFF09\n3. AIGOI \u7684\u52A8\u4F5C\u6539\u4E3A\u300C\u624B\u6307\u6ED1\u52A8\u50CF\u7D20/\u5E27\u300D\uFF0C\u76F4\u63A5\u8D70\u6E38\u620F\u539F\u672C\u7684 \u00D70.05\u3001\u52A0\u901F\u5EA6\u66F2\u7EBF\u3001\u5E73\u6ED1\n\n\u4E3A\u4EC0\u4E48\u4E4B\u524D\u4E00\u76F4\u4E0D\u5BF9\uFF1A\n  \u6211\u4E00\u76F4\u5728\u4E0B\u6E38\u76F4\u63A5\u5199 cursorInputVelocity\uFF0C\u7B49\u4E8E\u8DF3\u8FC7\u4E86\u6574\u6761\u6D41\u6C34\u7EBF\u3002\n  \u8BFB\u5B8C\u6574\u6E90\u7801\u540E\u7B97\u51FA\u771F\u5B9E\u503C\u7EA6 5~15\uFF0C\u800C\u6211\u4E00\u5EA6\u8BBE\u6210 150\uFF08\u5927 20 \u500D\uFF09\uFF0C\n  \u4F4D\u79FB\u53CD\u800C\u6BD4\u8BBE 3 \u65F6\u5C0F 10 \u500D \u2014\u2014 \u8C03\u4E86 5 \u8F6E\u90FD\u6CA1\u8C03\u5BF9\u3002\n\n\u00B7 \u8BA1\u5206\uFF1A\u7EAF\u6B63\u5411\uFF08\u53EA\u6709\u5237\u65B0\u6CBF\u5207\u7EBF\u7684\u6700\u8FDC\u91CC\u7A0B\u624D\u52A0\u5206\uFF0C\u540E\u9000\u4E0D\u6263\uFF09\n\u00B7 \u9002\u5E94\u5EA6 = \u6700\u8FDC\u91CC\u7A0B MaxRun \u002B \u51C0\u5F97\u5206 Score\n\u00B7 \u8BB0\u5F55\uFF1AMods/AIGOI/genome.txt\uFF0C\u6BCF\u5C40\u5199\u76D8\n\u00B7 \u8BCA\u65AD\uFF1A[AIGOI\u8BCA\u65AD] \u6BCF\u79D2\u4E00\u884C\uFF08TF/\u73A9\u5BB6Y/\u4F4D\u79FB/\u5207\u7EBF/\u70B9\u79EF/\u91CC\u7A0B/\u5F97\u5206\uFF09"
        }
      ]
    }
